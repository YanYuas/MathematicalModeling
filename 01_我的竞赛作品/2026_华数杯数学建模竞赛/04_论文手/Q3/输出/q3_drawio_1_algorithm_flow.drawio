<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Claude" modified="2026-08-09T00:00:00.000Z" agent="Claude Code" version="30.0.2">
  <diagram id="algorithm-flow" name="算法流程图">
    <mxGraphModel dx="1422" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="算法流程：二分收缩求最小死区比例Γ*" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="30" width="500" height="40" as="geometry"/>
        </mxCell>

        <!-- 开始 -->
        <mxCell id="start" value="开始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- 初始化 -->
        <mxCell id="init" value="初始化&lt;br&gt;S_upper = M_Q1 (问题一解边长)&lt;br&gt;S_lower = ⌈√A⌉ (面积下界)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="190" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- 箭头1 -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="start" target="init">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 计算中点 -->
        <mxCell id="midpoint" value="S_mid = (S_upper + S_lower) / 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="300" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- 箭头2 -->
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="init" target="midpoint">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 判可行（决策菱形） -->
        <mxCell id="check_feasible" value="判可行(S_mid)&lt;br&gt;FFD + Skyline" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="400" width="180" height="120" as="geometry"/>
        </mxCell>

        <!-- 箭头3 -->
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="midpoint" target="check_feasible">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 可行分支：收缩上界 -->
        <mxCell id="feasible_yes" value="S_upper = S_mid&lt;br&gt;(可行下压)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="570" width="150" height="60" as="geometry"/>
        </mxCell>

        <!-- 箭头4 Yes -->
        <mxCell id="arrow4" value="可行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;fontColor=#008000;" edge="1" parent="1" source="check_feasible" target="feasible_yes">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="305" y="460"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 不可行分支：提升下界 -->
        <mxCell id="feasible_no" value="S_lower = S_mid + 1&lt;br&gt;(不可行上探)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="570" width="170" height="60" as="geometry"/>
        </mxCell>

        <!-- 箭头5 No -->
        <mxCell id="arrow5" value="不可行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;fontColor=#CC0000;" edge="1" parent="1" source="check_feasible" target="feasible_no">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="785" y="460"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 判断收敛 -->
        <mxCell id="converge_check" value="收敛？&lt;br&gt;|S_upper - S_lower| ≤ 1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="465" y="700" width="150" height="100" as="geometry"/>
        </mxCell>

        <!-- 箭头6 from Yes -->
        <mxCell id="arrow6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;endFill=0;" edge="1" parent="1" source="feasible_yes" target="converge_check">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="305" y="750"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 箭头7 from No -->
        <mxCell id="arrow7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;endFill=0;" edge="1" parent="1" source="feasible_no" target="converge_check">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="785" y="750"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 未收敛：循环回去 -->
        <mxCell id="loop_back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=1;dashPattern=5 5;strokeColor=#666666;" edge="1" parent="1" source="converge_check" target="midpoint">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="750"/>
              <mxPoint x="350" y="325"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="loop_label" value="未收敛&lt;br&gt;继续二分" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="250" y="600" width="90" height="40" as="geometry"/>
        </mxCell>

        <!-- 输出结果 -->
        <mxCell id="output" value="输出 S* = S_upper&lt;br&gt;Γ* = (S*² / A) - 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="850" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- 箭头8 收敛 -->
        <mxCell id="arrow8" value="收敛" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=12;fontColor=#008000;" edge="1" parent="1" source="converge_check" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 结束 -->
        <mxCell id="end" value="结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="480" y="960" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- 箭头9 -->
        <mxCell id="arrow9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="output" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 注释框：连续可行链 -->
        <mxCell id="note1" value="💡 连续可行链：&lt;br&gt;始终保持S_upper可行，&lt;br&gt;从Γ=0.15沿Γ下降追踪" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="400" width="150" height="100" as="geometry"/>
        </mxCell>

        <!-- 注释框：判可行子程序 -->
        <mxCell id="note2" value="🔧 判可行(S)：&lt;br&gt;1. FFD行堆叠（h降序）&lt;br&gt;2. Skyline bottom-left&lt;br&gt;3. 长条旋转（AR≥2.5）&lt;br&gt;4. 硬门：W≤S ∧ H≤S" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="920" y="380" width="160" height="140" as="geometry"/>
        </mxCell>

        <!-- 箭头：注释指向 -->
        <mxCell id="note_arrow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeWidth=1;dashed=1;strokeColor=#999999;endFill=0;" edge="1" parent="1" source="note2" target="check_feasible">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
