          <mxGeometry x="220" y="530" width="200" height="30" as="geometry"/>
        </mxCell>

        <!-- 三步解释 -->
        <mxCell id="step1" value="① 紧布局（Γ* 最小）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="220" y="570" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="step1_text" value="✓ 死区最小&lt;br&gt;✗ 模块紧密 → 终端分散&lt;br&gt;✗ 线网跨度大（HPWL↑）&lt;br&gt;&lt;br&gt;权衡：牺牲线长换死区" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="600" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="step2" value="② 松布局（Γ=0.15 宽松）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="450" y="570" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="step2_text" value="✓ 线长减小（模块可移动）&lt;br&gt;✗ 死区增大&lt;br&gt;&lt;br&gt;权衡：用死区换线长改善" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="600" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="step3" value="③ 非线性放大" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="680" y="570" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="step3_text" value="Γ从Γ*到0.15：&lt;br&gt;死区↑ 9% → 17%（2倍）&lt;br&gt;HPWL↑ 1.5~2.7%&lt;br&gt;&lt;br&gt;边际效应：越紧代价越大" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="600" width="180" height="80" as="geometry"/>
